rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    // Professional credentials: public read, authenticated admin write
    match /credentials/{credentialId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Projects highlights: public read, authenticated admin write
    match /projects/{projectId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Authored books & publications: public read, authenticated admin write
    match /books/{bookId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Inbound inquiries: public create, read, update, and delete
    match /inquiries/{inquiryId} {
      allow read, write: if true;
    }

    // Admin users profile: user themselves
    match /users/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    // Default catch-all deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
